// ─────────────────────────────────────────────────────────────────────────────
//  BASE DE DATOS: usuarios_db
//  Responsabilidad: Autenticación y gestión de perfiles de usuario.
//  Tablas: User, Profile, Photo
//
//  SEPARACIÓN:
//    User    → datos de autenticación (email, password, phone, name, age)
//    Profile → detalles del perfil (bio, género, intereses, integrations, etc.)
//    Photo   → imágenes del usuario
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma/client-usuarios"
}

datasource db {
  provider = "postgresql"
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum SubscriptionTier {
  FREE
  BRONZE
  GOLD
  PREMIUM
  PLATINUM
}

// ─── AUTENTICACIÓN ───────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  phone     String?  @unique
  name      String
  age       Int

  // Relaciones dentro de usuarios_db
  profile   Profile?
  photos    Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── PERFIL (nueva tabla recomendada por el ingeniero) ───────────────────────

model Profile {
  id                Int              @id @default(autoincrement())

  // Relación 1-a-1 con User
  userId            Int              @unique
  user              User             @relation(fields: [userId], references: [id])

  // Detalles personales
  bio               String?
  weight            Float?
  height            Float?
  nationality       String?
  gender            Gender?
  city              String?
  country           String?

  // Intereses & estilo de vida
  zodiacSign        String?
  seeking           String?
  location          String?
  job               String?
  hobbies           String[]

  // Integraciones externas
  spotifyId         String?
  musicList         String[]

  // Suscripción y configuración
  subscription      SubscriptionTier @default(FREE)
  donationsEnabled  Boolean          @default(false)

  // Seguridad
  isRestricted      Boolean          @default(false)

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

// ─── FOTOS ───────────────────────────────────────────────────────────────────

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  isPrimary Boolean  @default(false)

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}
