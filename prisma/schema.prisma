// ─────────────────────────────────────────────────────────────────────────────
//  CONFIGURACIÓN PRISMA
//  multiSchema permite asignar cada tabla a un schema de PostgreSQL distinto,
//  separando físicamente la BD por función del sistema.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["usuarios", "suscripciones", "social", "mensajeria"]
}

// ─────────────────────────────────────────────────────────────────────────────
//  ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER

  @@schema("usuarios")
}

enum SubscriptionTier {
  FREE
  BRONZE
  GOLD
  PREMIUM
  PLATINUM

  @@schema("suscripciones")
}

enum InteractionType {
  LIKE
  DISLIKE
  SUPERLIKE
  REPORT

  @@schema("social")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MÓDULO 1 — USUARIOS & PERFILES  (schema: "usuarios")
//
//  Responsabilidad: Registro, autenticación y datos del perfil del usuario.
//  Tablas: User, Photo
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id               Int              @id @default(autoincrement())
  email            String           @unique
  password         String
  phone            String?          @unique
  name             String
  age              Int
  bio              String?
  weight           Float?
  height           Float?
  nationality      String?
  gender           Gender?
  city             String?
  country          String?

  // Intereses & Detalles
  zodiacSign       String?
  seeking          String?
  location         String?
  job              String?
  hobbies          String[]

  // Integraciones externas
  spotifyId        String?
  musicList        String[]

  // Suscripción
  subscription     SubscriptionTier @default(FREE)
  subscriptionPlan SubscriptionPlan @relation(fields: [subscription], references: [tier])
  donationsEnabled Boolean          @default(false)

  // Seguridad / Restricciones
  isRestricted     Boolean          @default(false)

  // Relaciones
  photos           Photo[]
  likesSent        Interaction[]    @relation("LikesSent")
  likesReceived    Interaction[]    @relation("LikesReceived")
  matchesAsUser1   Match[]          @relation("User1Matches")
  matchesAsUser2   Match[]          @relation("User2Matches")
  messagesSent     Message[]        @relation("UserMessages")

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@schema("usuarios")
}

model Photo {
  id        Int      @id @default(autoincrement())
  url       String
  isPrimary Boolean  @default(false)

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@schema("usuarios")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MÓDULO 2 — SUSCRIPCIONES  (schema: "suscripciones")
//
//  Responsabilidad: Planes de membresía y monetización del servicio.
//  Tablas: SubscriptionPlan
// ─────────────────────────────────────────────────────────────────────────────

model SubscriptionPlan {
  tier        SubscriptionTier @id
  name        String
  description String
  price       Float
  features    String[]

  users       User[]

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@schema("suscripciones")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MÓDULO 3 — INTERACCIONES & MATCHES  (schema: "social")
//
//  Responsabilidad: Gestión de likes, dislikes, superlikes, reportes y
//                   coincidencias (matches) entre usuarios.
//  Tablas: Interaction, Match
// ─────────────────────────────────────────────────────────────────────────────

model Interaction {
  id        Int             @id @default(autoincrement())
  type      InteractionType

  fromId    Int
  toId      Int

  fromUser  User            @relation("LikesSent", fields: [fromId], references: [id])
  toUser    User            @relation("LikesReceived", fields: [toId], references: [id])

  createdAt DateTime        @default(now())

  @@unique([fromId, toId])
  @@schema("social")
}

model Match {
  id        Int      @id @default(autoincrement())

  user1Id   Int
  user2Id   Int

  user1     User     @relation("User1Matches", fields: [user1Id], references: [id])
  user2     User     @relation("User2Matches", fields: [user2Id], references: [id])

  chat      Chat?
  createdAt DateTime @default(now())

  @@unique([user1Id, user2Id])
  @@schema("social")
}

// ─────────────────────────────────────────────────────────────────────────────
//  MÓDULO 4 — CHAT & MENSAJERÍA  (schema: "mensajeria")
//
//  Responsabilidad: Conversaciones privadas entre usuarios con match.
//  Tablas: Chat, Message
// ─────────────────────────────────────────────────────────────────────────────

model Chat {
  id        Int       @id @default(autoincrement())

  matchId   Int       @unique
  match     Match     @relation(fields: [matchId], references: [id])

  messages  Message[]
  createdAt DateTime  @default(now())

  @@schema("mensajeria")
}

model Message {
  id        Int      @id @default(autoincrement())
  content   String

  fromId    Int
  fromUser  User     @relation("UserMessages", fields: [fromId], references: [id])

  chatId    Int
  chat      Chat     @relation(fields: [chatId], references: [id])

  createdAt DateTime @default(now())

  @@schema("mensajeria")
}
