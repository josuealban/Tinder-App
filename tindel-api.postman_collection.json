{
  "info": {
    "name": "Tindel API",
    "description": "Colección completa de endpoints para la API de Tindel (clon de Tinder). Puerto por defecto: 3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string",
      "description": "JWT token obtenido tras el login. Se llena automáticamente si usas el script del endpoint /auth/login."
    }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "Endpoints públicos de autenticación (no requieren JWT).",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"secret123\",\n  \"name\": \"Juan Pérez\",\n  \"age\": 25,\n  \"phone\": \"+593987654321\",\n  \"bio\": \"Me gusta el cine y los viajes.\",\n  \"weight\": 72.5,\n  \"height\": 175.0,\n  \"nationality\": \"Ecuatoriana\",\n  \"gender\": \"MALE\",\n  \"city\": \"Quito\",\n  \"country\": \"Ecuador\",\n  \"zodiacSign\": \"Tauro\",\n  \"seeking\": \"Relación seria\",\n  \"location\": \"-0.1807,-78.4678\",\n  \"job\": \"Ingeniero de Software\",\n  \"hobbies\": [\"Música\", \"Senderismo\", \"Fotografía\"],\n  \"spotifyId\": \"spotify:user:juanperez\",\n  \"musicList\": [\"Rock\", \"Jazz\"],\n  \"subscription\": \"FREE\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.access_token) {",
                  "  pm.collectionVariables.set('token', res.access_token);",
                  "  console.log('Token guardado:', res.access_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"juan@example.com\",\n  \"password\": \"secret123\"\n}"
            }
          }
        }
      ]
    },
    {
